# This is the configuration file for Canasta.
# Warning: do not edit this file directly unless absolutely necessary.
# Insead, modify it with "canasta config set". In addition to helping
# avoid entering invalid data, often "canasta config set" will also invoke
# necessary side-effects that simply editing the file would not trigger.
# The command will also restart Canasta if necessary.

HTTP_PORT={{http_port}}
HTTPS_PORT={{https_port}}
MYSQL_PASSWORD={{mysql_password}}
MW_SITE_SERVER={{mw_site_server}}
MW_SITE_FQDN={{mw_site_fqdn}}
PHP_UPLOAD_MAX_FILESIZE=10M
PHP_POST_MAX_SIZE=10M
PHP_MAX_INPUT_VARS=1000
CANASTA_ENABLE_ELASTICSEARCH={{canasta_enable_elasticsearch}}
CANASTA_ENABLE_VARNISH={{canasta_enable_varnish}}
CANASTA_ENABLE_WIKI_DIRECTORY=false
MW_SITEMAP_PAUSE_DAYS=1
USE_EXTERNAL_DB=false

CANASTA_IMAGE=ghcr.io/canastawiki/canasta:3.5.23
COMPOSE_PROFILES=varnish,internal-db
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_SSL=false
MW_SECRET_KEY={{mw_secret_key}}

CANASTA_STAGING_CERTS=false
RESTIC_REPOSITORY={{restic_repository}}
RESTIC_PASSWORD={{restic_password}}
